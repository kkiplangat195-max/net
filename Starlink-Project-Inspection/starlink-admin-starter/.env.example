# Backend (Render)
PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
ADMIN_EMAIL=admin@example.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-long-password', 12))"
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
JWT_SECRET=replace_with_at_least_32_random_bytes
TELEGRAM_BOT_TOKEN=
# Optional; only configure if a real, authorized EcoCash provider integration is implemented.
ECOCASH_WEBHOOK_SECRET=
# Worker polling interval in milliseconds
NOTIFICATION_POLL_MS=5000
